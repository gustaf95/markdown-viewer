{
  "name": "markdown-viewer",
  "productName": "Markdown Viewer",
  "version": "0.1.0",
  "description": "Windows용 한글 친화 Markdown Viewer (Electron + TypeScript)",
  "author": "gustaf95",
  "license": "MIT",
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "esbuild src/renderer/renderer.ts --bundle --outfile=dist/renderer/renderer.js --platform=browser --target=chrome120 --sourcemap --loader:.woff=file --loader:.woff2=file --loader:.ttf=file --loader:.otf=file --loader:.eot=file --asset-names=assets/[name]-[hash]",
    "build:assets": "node scripts/copy-assets.js",
    "build": "npm run build:main && npm run build:renderer && npm run build:assets",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "make:testdocs": "node scripts/make-test-docs.js",
    "make:icons": "node scripts/make-icons.js",
    "dist": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "iconv-lite": "^0.6.3"
  },
  "devDependencies": {
    "@milkdown/crepe": "^7.22.1",
    "@types/katex": "^0.16.7",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.0",
    "dompurify": "^3.2.3",
    "electron": "^33.3.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.19",
    "markdown-it": "^14.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "typescript": "^5.7.2"
  }
}
